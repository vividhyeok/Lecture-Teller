{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LectureTeller",
  "version": "1.0.0",
  "identifier": "com.lectureteller",
  "build": {
    "frontendDist": "loading"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/server"
    ],
    "resources": {
      "../../static-v2": "static-v2/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null
    }
  }
}
